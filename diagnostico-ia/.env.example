# ==========================================================
# Asistente de diagnostico - variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (ya esta en .gitignore) ni pegues la key aqui
# en este .env.example. Tampoco la pegues en un chat, issue, PR, etc.
# ==========================================================

# API key de Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=

# Modelo a usar. Para este prototipo: llama-3.3-70b-versatile
# La lista de modelos de Groq cambia con el tiempo (agregan y retiran
# modelos): si este deja de existir, revisa https://console.groq.com/docs/models
MODEL_NAME=llama-3.3-70b-versatile

# Opcionales (si los dejas vacios se usan estos mismos valores por defecto).
LLM_TIMEOUT_SEGUNDOS=60
LLM_MAX_TOKENS=1500
