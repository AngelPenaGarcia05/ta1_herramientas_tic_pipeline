# ==========================================================
# NovaMarket - Variables de entorno
# Copia este archivo como .env y completa los valores reales
# ==========================================================

# Conexion a PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/novamarket?schema=public"

# Secreto para firmar las sesiones (JWT). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"

# URL publica de la aplicacion (usada en metadatos)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
